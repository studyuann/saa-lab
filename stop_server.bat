@echo off
chcp 65001 >nul

echo ========================================================
echo  🛑 AWS SAA-C03 퀴즈 서버(포트 5000)를 종료합니다...
echo ========================================================

for /f "tokens=5" %%a in ('netstat -aon ^| findstr :5000') do (
    taskkill /F /PID %%a >nul 2>&1
)

echo ✅ 5000번 포트 서버가 안전하게 종료되었습니다.
echo ========================================================
timeout /t 3 >nul
